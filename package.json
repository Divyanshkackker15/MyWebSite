    "preview": "node scripts/serve-dist.mjs",
    "typecheck": "tsc --noEmit",
    "photo": "python3 scripts/photo/portrait_bw.py",
    "renders": "node scripts/renders/render.mjs",
    "favicons": "node scripts/favicons.mjs"
  },
