    "@mdx-js/react": "^3.1.1",
    "@react-three/fiber": "^9.8.2",
    "lenis": "^1.3.27",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "three": "^0.180.0"
  },
